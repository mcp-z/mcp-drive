# Google Drive MCP Server - Example Configuration
# Copy this file to .env or integrate into your shell environment

# ============================================================================
# REQUIRED: Google OAuth Client Credentials
# ============================================================================
# Get these from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-client-id-here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret-here

# ============================================================================
# OPTIONAL: Configuration Overrides
# ============================================================================

# Logging: Control log verbosity
# Options: error, warn, info, debug (default: info)
# LOG_LEVEL=info

# HTTP Server: Port for HTTP transport
# Dynamically assigned using get-port - DO NOT hardcode
# TRANSPORT=http

# ============================================================================
# Quick Start
# ============================================================================
# 1. Fill in your GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET above
# 2. Run: npm run test:setup  (one-time OAuth authorization)
# 3. Run: npm run start  (start the server)
#
# For stdio mode (Claude Desktop), no setup needed - OAuth happens on first use

# ============================================================================
# TESTS: Shared drive
# ============================================================================
# Id of a hand-provisioned shared drive the test account is a Manager of.
# Shared drives can only be created by a Google Workspace account; the test
# account only needs membership. Manager (not Content manager) because test
# cleanup permanently deletes what it creates. See test/lib/shared-drive.ts.
# TEST_SHARED_DRIVE_ID=0ABCdEfGhIjKlMnOpQr
#
# Service account key file. The shared-drive specs authenticate as this account
# rather than the human test account: a service account has no Drive storage
# quota of its own, so a shared drive is the only place it can hold content.
# Add its client_email to the shared drive as a Manager.
# GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./service-account.test.json
